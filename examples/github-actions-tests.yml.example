name: Local tests
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: python -m pip install -r ixl-agent/scripts/requirements.txt
      - run: python -m playwright install --with-deps chromium
      - run: python -m pytest ixl-agent/scripts/tests -q
        env:
          PYTHONPATH: ixl-agent/scripts/runtime:ixl-agent/scripts:ixl-agent/scripts/adapters
